{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "smartlaunch-booking",
	// SvelteKit's Worker plus a scheduled job that retries unfinished payments; see worker/index.js.
	"main": "worker/index.js",
	"compatibility_date": "2026-10-26",
	"compatibility_flags": [
		"nodejs_als"
	],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smartlaunch-esportsnord",
			// Replace with the id printed by `npx wrangler d1 create smartlaunch-booking`.
			"database_id": "0316e262-ab46-412d-b8bf-67c1a5943369",
			"migrations_dir": "migrations"
		}
	],
	// The site's address. Cloudflare creates the DNS record and certificate on deploy.
	"routes": [
		{
			"pattern": "booking.esportsnord.com",
			"custom_domain": true
		}
	],
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"vars": {
    "CENTER_TIMEZONE": "Europe/Berlin",
    "DEFAULT_LANGUAGE": "en",
    "PUBLIC_ALLOW_SIGNUP": "true",
    "PUBLIC_CENTER_NAME": "eSports Nord",
    "THEME": "esportsnord",
    "TOPUP_AMOUNTS": "10,20,50",
    "TOPUP_MAX": "200",
    "TOPUP_MIN": "5"
  },
}
