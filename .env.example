# Copy to .env (for `npm run dev`) or .dev.vars (for `npm run preview`).
# In production, set these in the Worker's Settings > Variables and Secrets.

# Smartlaunch server REST API (RESTServiceMain). Must be reachable from Cloudflare by hostname.
SL_API_URL=https://booking-api.example.com
SL_API_USERNAME=
SL_API_PASSWORD=

# Optional: only needed when the API sits behind a relay that routes by license email.
SL_LICENSE_EMAIL=

# Random string, 32+ characters. e.g. `node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
SESSION_SECRET=

# Optional IANA zone of the center; enables the server-side "earliest arrival is the next full hour" check.
CENTER_TIMEZONE=Asia/Jakarta

PUBLIC_CENTER_NAME=Smartlaunch

# Let visitors create an account at /signup. Set to false to turn it off.
PUBLIC_ALLOW_SIGNUP=true

# Language for visitors whose browser asks for none of the supported ones (en, de, da).
# Visitors can always switch with the flags in the header.
DEFAULT_LANGUAGE=en

# Online top-ups. Leave PAYMENT_PROVIDER empty to turn payments off.
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=EUR
TOPUP_AMOUNTS=10,20,50
TOPUP_MIN=5
TOPUP_MAX=200
# SumUp Dashboard > Developers. Store the key as a secret in production.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Booking prices: "r7" for the eSports Nord HUB price list. Empty shows no prices.
PRICE_RULES=
# Optional: which Smartlaunch user group gives which plan, when the names differ.
# PLAN_GROUPS=campus=Campus,pro=Pro,alpha=Alpha,team=TEAM

# Look of the site: a folder name under src/themes (e.g. default, esportsnord).
# Unset or unknown names fall back to "default".
THEME=default

# Optional "not a robot" check on sign-up (Cloudflare Turnstile). Set both to turn it on;
# store the secret with `npx wrangler secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
